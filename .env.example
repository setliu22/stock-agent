# Required for general chat and narrative analysis.
GROQ_API_KEY=replace_me

# Optional. Change this if your Groq account uses a different model.
GROQ_MODEL=llama-3.3-70b-versatile

# The local LSEG Workspace desktop session.
LSEG_SESSION=desktop.workspace

# Optional desktop application key. Add only if Test LSEG reports that the session remains Closed.
LSEG_APP_KEY=

# Seconds to wait for Workspace to open the local Python session.
LSEG_SESSION_TIMEOUT=8

# Maximum seconds for one LSEG HTTP request before that evidence family is skipped.
# Lower this if your connection repeatedly stalls on optional ownership or event data.
LSEG_REQUEST_TIMEOUT=20
